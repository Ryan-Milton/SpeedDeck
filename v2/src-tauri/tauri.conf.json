{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpeedDeck",
  "version": "2.0.0",
  "identifier": "com.speeddeck.carplay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SpeedDeck",
        "fullscreen": true,
        "resizable": true,
        "width": 1280,
        "height": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "shortDescription": "CarPlay-style infotainment for the Steam Deck",
    "longDescription": "SpeedDeck is a self-contained, CarPlay-style in-car infotainment app for the Steam Deck: offline maps with turn-by-turn navigation driven by a USB GPS receiver, local music, trip recording, and a dashboard split view.",
    "externalBin": ["binaries/osrm-routed"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
