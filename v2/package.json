{
  "name": "speeddeck-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Automotive navigation and media HUD for the Steam Deck (Tauri 2 + React)",
  "engines": {
    "node": "22.14.x",
    "npm": "10.9.x"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "dev:sim": "SPEEDDECK_SIMULATOR=1 tauri dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "release:preflight": "bash ./scripts/check-release-assets.sh",
    "release:maps": "bash ./scripts/download-tiles.sh",
    "release:sidecar": "bash ./scripts/fetch-osrm-sidecar.sh",
    "bundle:appimage": "bash ./scripts/bundle-appimage-docker.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "maplibre-gl": "^5.21.1",
    "pmtiles": "^4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
