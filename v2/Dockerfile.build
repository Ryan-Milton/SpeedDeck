# Pinned-toolchain AppImage build for SpeedDeck v2 (Tauri 2 + React).
#
# Usage (BuildKit, writes the AppImage to ./dist):
#   DOCKER_BUILDKIT=1 docker build --platform linux/amd64 -f Dockerfile.build \
#     --output type=local,dest=dist .
#
# The build context must include the generated PMTiles packs and the Linux
# navigation sidecar. check-release-assets.sh verifies them before building.

ARG SPEEDDECK_PLATFORM=linux/amd64
FROM --platform=$SPEEDDECK_PLATFORM node:22.14.0-bookworm-slim AS node
FROM --platform=$SPEEDDECK_PLATFORM rust:1.89.0-bookworm AS builder

ARG TARGETARCH
ARG TARGETOS

# Use the Node/npm pair declared in package.json instead of a mutable setup
# script. Both stages are Debian bookworm, so the copied runtime is compatible.
COPY --from=node /usr/local /usr/local

# Tauri / WebKitGTK build dependencies.
RUN test "$TARGETOS" = linux \
    && test "$TARGETARCH" = amd64 \
    && test "$(dpkg --print-architecture)" = amd64 \
    && test "$(uname -m)" = x86_64

RUN apt-get update && apt-get install -y --no-install-recommends \
        libwebkit2gtk-4.1-dev build-essential file pkg-config libssl-dev \
        libasound2-dev libudev-dev libxdo-dev \
        libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev \
        ca-certificates fuse libfuse2 \
    && rm -rf /var/lib/apt/lists/*

# AppImage tooling (linuxdeploy) runs FUSE-less inside Docker.
ENV APPIMAGE_EXTRACT_AND_RUN=1 \
    CARGO_INCREMENTAL=0 \
    npm_config_update_notifier=false

WORKDIR /app
COPY . .

RUN npm run release:preflight -- x86_64-unknown-linux-gnu \
    && npm ci \
    && npm run tauri:build \
    && test -s src-tauri/target/release/bundle/appimage/SpeedDeck_*.AppImage

# Export stage: only the AppImage artifact(s).
FROM --platform=$SPEEDDECK_PLATFORM scratch AS export
COPY --from=builder /app/src-tauri/target/release/bundle/appimage/*.AppImage /
