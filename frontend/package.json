{
  "name": "speeddeck",
  "version": "0.1.0",
  "description": "SpeedDeck — GPS Speedometer HUD for Steam Deck",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "clsx": "^2.1.0",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^5.21.1",
    "pmtiles": "^4.4.0",
    "postcss": "^8.5.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.speeddeck",
    "productName": "SpeedDeck",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "../backend/dist/gps-speedometer-backend",
        "to": "backend/gps-speedometer-backend"
      },
      {
        "from": "resources/map",
        "to": "map",
        "filter": ["**/*"]
      }
    ]
  }
}
